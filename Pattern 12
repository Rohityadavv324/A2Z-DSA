//6 4 2 0 (spaces)
//1 2 3 4 (i)
//4 4 4 4 (n)
//(n-i)*2
class Main {
    public static void main(String[] args) {
        int n=4;
        for(int i=1;i<=n;i++){
            for(int j=1;j<=i;j++){
                System.out.print(j);
            }
            for(int j=1;j<=(n-i)*2;j++){
                System.out.print(" ");
            }
            for(int j=i;j>=1;j--){
                System.out.print(j);
            }
        System.out.println();
        }
        
    }
}
