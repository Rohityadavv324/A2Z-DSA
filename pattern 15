
class Main{
    public static void main(String[] args){
        int n=5;
        for(int i=n;i>=1;i--){
            char A = 65;
            for(int j=1;j<=i;j++){
                System.out.print(A + " ");
                A++;
            }
            System.out.println();
        }
        
    }
}
